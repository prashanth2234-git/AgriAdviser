NODE_ENV=development

PORT=4000

# Optional external PostgreSQL connection string.
# If left empty, the application uses its built-in PostgreSQL engine (zero-config local persistence).
DATABASE_URL=

# Gemini API configuration (Server-side ONLY. Never expose to client.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Client and CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
